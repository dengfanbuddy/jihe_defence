{
  "name": "jihe-excel-export",
  "version": "1.0.0",
  "private": true,
  "description": "《集合防御》配表工具：Excel ⇄ tb JSON 双向转换",
  "type": "module",
  "scripts": {
    "export": "node src/cli.ts excel2json",
    "import": "node src/cli.ts json2excel",
    "check": "node src/cli.ts excel2json --check",
    "verify": "node src/cli.ts verify",
    "check:shop": "node scripts/check-shop-draw.mjs",
    "check:affix": "node scripts/check-affix-gating.mjs",
    "migrate:affix": "node scripts/migrate-affix-gating.mjs",
    "fix:crit": "node scripts/fix-crit-baseline.mjs",
    "gen:relic-design": "node scripts/gen-relic-inner-design-doc.mjs",
    "gen:relic-hooks": "node scripts/gen-relic-hook-modifiers.mjs",
    "gen:relics-inner": "node scripts/gen-relics-inner-from-design.mjs",
    "audit:attr": "node ../attr-audit/audit.mjs",
    "audit:hitfeel": "node ../hit-feel-audit/audit.mjs",
    "audit:reach": "node ../monster-reach-audit/audit.mjs",
    "audit:slot": "node ../skill-slot-audit/audit.mjs",
    "audit:hero": "node ../hero-audit/verify-heroes.mjs",
    "audit:skill": "node ../skill-audit/verify-skills.mjs",
    "audit:achieve": "node ../achievement-audit/verify-achievements.mjs",
    "audit:herocard": "node ../hero-card-audit/audit.mjs",
    "audit:ui": "node ../ui-token-audit/audit.mjs",
    "audit:mall": "node ../mall-audit/audit.mjs",
    "audit:bag": "node ../bag-audit/audit.mjs",
    "audit:draw": "node ../outer-draw-audit/audit.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:diff": "node ../typecheck-diff/check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "exceljs": "^4.4.0",
    "typescript": "^6.0.3"
  }
}
